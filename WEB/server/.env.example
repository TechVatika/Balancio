PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=balancio

# Origin the browser app is served from (lets the API set credentialed cookies safely).
CLIENT_ORIGIN=http://localhost:5173

# MASTER_KEY, SESSION_SECRET, and ADMIN_PASSWORD_HASH are generated automatically on first
# run and saved to server/.env — you don't need to set them yourself. Keep that file private
# and out of git; losing MASTER_KEY makes every encrypted description unrecoverable.
